APP_NAME=Agent-Pilot Backend
DEBUG=true
MOCK_MODE=true

DATABASE_URL=sqlite+aiosqlite:///./data/agent_pilot.db

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4

LARK_APP_ID=your_lark_app_id_here
LARK_APP_SECRET=your_lark_app_secret_here
LARK_CLI_ENABLED=false
LARK_CLI_BIN=lark-cli
LARK_CLI_AS=user
LARK_DEFAULT_CHAT_ID=
LARK_CLI_TIMEOUT_SECONDS=30

HOST=0.0.0.0
PORT=8000
