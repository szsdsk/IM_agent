# Agent-Pilot backend environment sample
# Copy this file to backend/.env and replace the placeholder values.

# Application metadata and runtime mode.
APP_NAME=Agent-Pilot Backend
DEBUG=true
MOCK_MODE=true

# Database URL. The default SQLite path is resolved from the project root when you start uvicorn there.
DATABASE_URL=sqlite+aiosqlite:///./data/agent_pilot.db

# LLM provider. The backend uses an OpenAI-compatible chat completions API.
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Lark / Feishu app values. Keep empty when you only use the local demo or CLI user auth.
LARK_APP_ID=
LARK_APP_SECRET=

# Rocket.Chat integration. Leave empty when you only use the local web UI.
IM_PROVIDER=lark
ROCKET_CHAT_URL=
ROCKET_CHAT_USER=
ROCKET_CHAT_PASSWORD=

# Feishu bot integration. Configure these in Feishu Open Platform.
LARK_BOT_ENABLED=true
LARK_BOT_REQUIRE_MENTION=true
LARK_VERIFICATION_TOKEN=

# Lark CLI integration. Keep disabled unless lark-cli has been installed and logged in.
LARK_CLI_ENABLED=false

# Use "lark-cli" when it is available in PATH. On Windows, a full .cmd path is often safer.
# Example: C:\Users\<your-user>\AppData\Roaming\npm\lark-cli.cmd
LARK_CLI_BIN=lark-cli

# Current implementation defaults to user authorization.
LARK_CLI_AS=user

# Optional Feishu group chat id for delivery messages. Leave empty if you only upload files.
LARK_DEFAULT_CHAT_ID=

# Timeout in seconds for external lark-cli commands.
LARK_CLI_TIMEOUT_SECONDS=30

# Backend server binding.
HOST=0.0.0.0
PORT=8000
