# Agent-Pilot backend environment sample
# Copy this file to backend/.env and replace the placeholder values.

# Application metadata and runtime mode.
APP_NAME=Agent-Pilot Backend
DEBUG=true
MOCK_MODE=true

# Database URL. The default SQLite path is resolved from the project root when you start uvicorn there.
DATABASE_URL=sqlite+aiosqlite:///./data/agent_pilot.db

# LLM provider. The backend uses an OpenAI-compatible chat completions API.
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Voice command transcription. The current ASR path uses Feishu PCM recognition.
VOICE_TRANSCRIPTION_ENABLED=true
FEISHU_ASR_ENABLED=true
FEISHU_ASR_FORMAT=pcm
FEISHU_ASR_ENGINE_TYPE=16k_auto


# Lark / Feishu OpenAPI app values. Keep empty when you only use the local web demo.
LARK_APP_ID=
LARK_APP_SECRET=

# Rocket.Chat integration. Leave empty when you only use the local web UI or Feishu bot.
IM_PROVIDER=lark
ROCKET_CHAT_URL=
ROCKET_CHAT_USER=
ROCKET_CHAT_PASSWORD=

# AFFiNE canvas integration. Leave empty to use local mock canvas output.
AFFINE_URL=
AFFINE_TOKEN=

# Feishu bot integration. Configure these in Feishu Open Platform when using the bot entry.
LARK_BOT_ENABLED=true
LARK_BOT_REQUIRE_MENTION=true
LARK_VERIFICATION_TOKEN=
LARK_DEFAULT_CHAT_ID=

# Target Feishu cloud document folder token for generated docs.
# Copy it from a folder URL, for example https://xxx.feishu.cn/drive/folder/<folder_token>.
# Leave empty to let Feishu create docs in the app/default location, which may not appear in your personal cloud docs home.
LARK_DOC_FOLDER_TOKEN=

# Feishu card action callback URL. Set this in Feishu Open Platform > Bot > Card request URL.
# Example: https://your-domain.com/api/im/lark/card/action
LARK_CARD_CALLBACK_URL=

# Backend server binding.
HOST=0.0.0.0
PORT=8000
